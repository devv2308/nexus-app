# Backend URL for API calls
# In development, Vite proxies /api → localhost:8000 (no change needed here)
# For mobile access, replace with your PC's LAN IP:
#   VITE_API_BASE=http://192.168.1.10:8000
VITE_API_BASE=http://localhost:8000

# Optional: Anthropic API key for AI writing helper in posts
# Get yours at: https://console.anthropic.com/account/keys
# Leave blank to disable the AI writing assistant
VITE_ANTHROPIC_API_KEY=
