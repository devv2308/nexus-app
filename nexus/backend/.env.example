# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nexus

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS / App ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
# Add your PC's LAN IP to access from mobile (comma-separated):
#   FRONTEND_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
FRONTEND_ORIGINS=http://localhost:3000
DEBUG=true

# ── AI ─────────────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# Leave empty to use built-in demo mode (no real AI responses)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── Uploads ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
